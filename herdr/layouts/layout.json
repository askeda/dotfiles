{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "layout-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "layout-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "layout-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "sidebar-footer"
          },
          "size": {
            "px": 101
          }
        }
      ],
      "size": {
        "px": 272
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "layout-tabs"
          },
          "size": {
            "px": 48
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "background",
                  "border": {
                    "width": 1.5,
                    "color": "border"
                  },
                  "radius": 6,
                  "gap": 8,
                  "lone": true,
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "layout-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "layout-changes"
                      }
                    },
                    {
                      "id": "commits",
                      "type": "block",
                      "content": {
                        "mod": "commits"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 360
              }
            }
          ],
          "padding": 8,
          "gap": 8,
          "resizable": false
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "layout-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "terminal_padding": [
    14,
    0
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "movable": false,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
